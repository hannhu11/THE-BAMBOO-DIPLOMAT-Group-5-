{
  "$schema": "https://tr.designtokens.org/format/",
  "meta": {
    "name": "The Bamboo Diplomat — Design Tokens",
    "version": "1.0.0",
    "style": "Neo-Oriental Civic Strategy"
  },
  "color": {
    "bg": {
      "canvas":   { "value": "#07110E" },
      "panel":    { "value": "#0D1815" },
      "panel2":   { "value": "#11211C" },
      "elevated": { "value": "#162A23" }
    },
    "bamboo": {
      "900": { "value": "#0F3628" },
      "700": { "value": "#1C5C47" },
      "500": { "value": "#2F7D62" },
      "300": { "value": "#68A98F" },
      "100": { "value": "#B5D6C6" }
    },
    "gold": {
      "900": { "value": "#5C4416" },
      "700": { "value": "#8E6A24" },
      "500": { "value": "#B88A33" },
      "300": { "value": "#D8B46D" },
      "100": { "value": "#F0DFB6" }
    },
    "semantic": {
      "success": { "value": "#3D8C6A" },
      "warning": { "value": "#C08A2E" },
      "danger":  { "value": "#A9474F" },
      "info":    { "value": "#4E7EA7" },
      "focus":   { "value": "#D4AE63" }
    },
    "faction": {
      "west":       { "ink": "#C7D3E5", "accent": "#6B87B4", "pattern": "grid-diagonal" },
      "neighbor":   { "ink": "#E8C2A6", "accent": "#7A2A2E", "pattern": "pressure-arc" },
      "un":         { "ink": "#DAD6C4", "accent": "#5F7284", "pattern": "concentric-charter" },
      "vn_people":  { "ink": "#C7E1CE", "accent": "#2F7D62", "pattern": "bamboo-weave" }
    }
  },
  "typography": {
    "fontFamily": {
      "display": ["Be Vietnam Pro", "sans-serif"],
      "ui":      ["Be Vietnam Pro", "sans-serif"],
      "mono":    ["IBM Plex Mono", "Space Mono", "monospace"]
    },
    "scale": {
      "displayXL": { "size": 52, "weight": 700, "lh": 1.05 },
      "displayL":  { "size": 40, "weight": 700, "lh": 1.08 },
      "h1":        { "size": 30, "weight": 650, "lh": 1.15 },
      "h2":        { "size": 24, "weight": 650, "lh": 1.2 },
      "h3":        { "size": 20, "weight": 600, "lh": 1.25 },
      "bodyL":     { "size": 17, "weight": 450, "lh": 1.55 },
      "bodyM":     { "size": 15, "weight": 450, "lh": 1.55 },
      "meta":      { "size": 12.5, "weight": 500, "lh": 1.35 },
      "mono":      { "size": 13, "weight": 500, "lh": 1.3 }
    }
  },
  "radius": { "xs": 10, "sm": 14, "md": 18, "lg": 24, "xl": 32, "pill": 999 },
  "spacing": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64, "20": 80 },
  "motion": {
    "duration": { "fast": 140, "base": 220, "slow": 320, "reveal": 520 },
    "easing": {
      "standard": "cubic-bezier(.22,.61,.36,1)",
      "emphasis": "cubic-bezier(.2,.7,.1,1)"
    }
  },
  "touch": { "targetMin": 48, "focusRingPx": 3 }
}
